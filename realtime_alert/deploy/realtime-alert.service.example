[Unit]
Description=AI Trading Scout Eastmoney realtime collector
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/website/AI_Trading_Scout
ExecStart=/home/website/AI_Trading_Scout/.venv/bin/python -m realtime_alert.collector --symbols-file symbols.txt --market-hours
Restart=on-failure
RestartSec=10
TimeoutStopSec=30
KillSignal=SIGTERM
Environment=PYTHONUNBUFFERED=1
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
